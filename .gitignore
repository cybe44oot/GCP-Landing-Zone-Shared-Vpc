# Terraform working directories
**/.terraform/*

# Terraform state and backups
*.tfstate
*.tfstate.*

# Saved Terraform plans
*.tfplan
*.plan

# Live variable files; allow safe examples
*.tfvars
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Environment files and private credentials
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
credentials*.json
